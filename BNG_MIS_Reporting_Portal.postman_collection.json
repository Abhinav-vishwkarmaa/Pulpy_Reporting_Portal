{
  "info": {
    "name": "BNG MIS Reporting Portal",
    "description": "API collection with JWT auth. Bodies include required fields for each route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.token) pm.collectionVariables.set('auth_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bng.com\",\n  \"name\": \"Admin User\",\n  \"password\": \"admin123\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.token) pm.collectionVariables.set('auth_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bng.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/profile", "host": ["{{base_url}}"], "path": ["api","auth","profile"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Advertisers",
      "item": [
        {
          "name": "Create Advertiser",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Ads\",\n  \"email\": \"ops@acme.com\",\n  \"country\": \"US\",\n  \"company_name\": \"Acme Corp\",\n  \"website\": \"https://acme.com\",\n  \"notes\": \"Primary contact Jane Doe\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/advertisers", "host": ["{{base_url}}"], "path": ["api","admin","advertisers"] }
          }
        },
        {
          "name": "Update Advertiser",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Ads Updated\",\n  \"country\": \"CA\",\n  \"status\": \"inactive\",\n  \"notes\": \"Paused due to billing\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/advertisers/:id", "host": ["{{base_url}}"], "path": ["api","admin","advertisers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Get Advertiser",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/advertisers/:id", "host": ["{{base_url}}"], "path": ["api","admin","advertisers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "List Advertisers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/advertisers?status=active&country=US&search=acme&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api","admin","advertisers"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "country", "value": "US" },
                { "key": "search", "value": "acme" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Delete (Soft) Advertiser",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/admin/advertisers/:id", "host": ["{{base_url}}"], "path": ["api","admin","advertisers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
