{
  "info": {
    "name": "BNG MIS Reporting Portal",
    "description": "Complete API collection with JWT auth, auto-token handling, and full request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.token) pm.collectionVariables.set('auth_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bng.com\",\n  \"name\": \"Admin User\",\n  \"password\": \"admin123\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.data && res.data.token) pm.collectionVariables.set('auth_token', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bng.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/auth/profile", "host": ["{{base_url}}"], "path": ["api","auth","profile"] }
          }
        }
      ]
    },
    {
      "name": "Admin - Publishers",
      "item": [
        {
          "name": "Create Publisher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"publisher@example.com\",\n  \"mobile\": \"+919876543210\",\n  \"first_name\": \"Amit\",\n  \"last_name\": \"Sharma\",\n  \"company_name\": \"Amit Media Pvt Ltd\",\n  \"position\": \"Affiliate Manager\",\n  \"address\": \"123 Business Street, Sector 12\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"IN\",\n  \"zip_code\": \"400001\",\n  \"tax_invoice_details\": {\n    \"gst_number\": \"27ABCDE1234F1Z5\",\n    \"billing_name\": \"Amit Media Pvt Ltd\",\n    \"billing_address\": \"123 Business Street, Sector 12, Mumbai\"\n  },\n  \"payment_terms\": {\n    \"payment_cycle\": \"NET30\",\n    \"preferred_method\": \"bank_transfer\",\n    \"bank_details\": {\n      \"account_name\": \"Amit Media Pvt Ltd\",\n      \"account_number\": \"1234567890\",\n      \"ifsc\": \"HDFC0000123\",\n      \"bank_name\": \"HDFC Bank\"\n    }\n  },\n  \"global_postback_url\": \"https://publisher.com/postback?click_id={click_id}&payout={payout}\",\n  \"status\": \"pending\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/publishers", "host": ["{{base_url}}"], "path": ["api","admin","publishers"] }
          }
        },
        {
          "name": "Update Publisher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mobile\": \"+919999999999\",\n  \"first_name\": \"Updated\",\n  \"status\": \"active\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/publishers/:id", "host": ["{{base_url}}"], "path": ["api","admin","publishers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete Publisher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/admin/publishers/:id", "host": ["{{base_url}}"], "path": ["api","admin","publishers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "List Publishers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/publishers?status=active", "host": ["{{base_url}}"], "path": ["api","admin","publishers"], "query": [{ "key": "status", "value": "active" }] }
          }
        },
        {
          "name": "Get Publisher",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/publishers/:id", "host": ["{{base_url}}"], "path": ["api","admin","publishers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Admin - Offers",
