{
  "info": {
    "name": "BNG MIS Reporting Portal - Complete API Collection",
    "description": "Complete API collection with all routes including Publishers, Offers, Advertisers, Assignments, Tracking, Postback, and Reporting. Supports both Basic Auth and JWT Bearer tokens.",
