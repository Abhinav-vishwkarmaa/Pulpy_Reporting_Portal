            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/reports/summary?date_from=2025-01-01&date_to=2025-01-31&offer_id=1",
              "host": ["{{base_url}}"],
              "path": ["api","admin","reports","summary"],
              "query": [
                { "key": "date_from", "value": "2025-01-01" },
                { "key": "date_to", "value": "2025-01-31" },
                { "key": "offer_id", "value": "1" }
