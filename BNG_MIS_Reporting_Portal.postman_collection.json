              "path": ["imp"],
              "query": [
                { "key": "offer_id", "value": "1" },
                { "key": "pub_id", "value": "1" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Postback (Public)",
      "item": [
        {
          "name": "Postback GET",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/postback?click_id=<click_uuid>&rcid=rcid123&amount=10.00&status=approved",
              "host": ["{{base_url}}"],
              "path": ["postback"],
              "query": [
                { "key": "click_id", "value": "<click_uuid>" },
                { "key": "rcid", "value": "rcid123" },
                { "key": "amount", "value": "10.00" },
                { "key": "status", "value": "approved" }
