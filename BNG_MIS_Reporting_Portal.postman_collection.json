          "name": "Get Offer",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/offers/:id", "host": ["{{base_url}}"], "path": ["api","admin","offers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "List Offers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/offers?status=live&advertiser_id=1&category=Shopping&search=promo&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api","admin","offers"],
              "query": [
                { "key": "status", "value": "live" },
                { "key": "advertiser_id", "value": "1" },
                { "key": "category", "value": "Shopping" },
                { "key": "search", "value": "promo" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
