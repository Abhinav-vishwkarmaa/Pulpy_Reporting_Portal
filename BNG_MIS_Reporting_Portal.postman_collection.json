            "body": { "mode": "raw", "raw": "{\n  \"status\": \"deactivate\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/offers/:id/status", "host": ["{{base_url}}"], "path": ["api","admin","offers",":id","status"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete Offer",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/admin/offers/:id", "host": ["{{base_url}}"], "path": ["api","admin","offers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "List All Offers",
          "request": {
