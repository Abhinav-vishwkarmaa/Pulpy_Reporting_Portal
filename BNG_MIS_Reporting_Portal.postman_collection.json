            "description": "Returns aggregated statistics for the main dashboard KPI cards including conversions, clicks, impressions, revenue, offers, publishers, and advertisers with today, yesterday, and MTD values."
          }
        },
        {
          "name": "Dashboard - Top Offers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/reports/dashboard/top-offers?limit=5&date_from=2024-01-01&date_to=2024-01-31",
              "host": ["{{base_url}}"],
              "path": ["api","admin","reports","dashboard","top-offers"],
              "query": [
                { "key": "limit", "value": "5", "description": "Number of top offers to return (default: 5)" },
                { "key": "date_from", "value": "2024-01-01", "description": "Start date (YYYY-MM-DD, default: today)" },
                { "key": "date_to", "value": "2024-01-31", "description": "End date (YYYY-MM-DD, default: today)" }
              ]
            },
            "description": "Returns top offers by conversion count. Results sorted by conversions (descending). Only offers with conversions > 0 are returned."
          }
        },
        {
          "name": "Dashboard - Performance Chart",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
