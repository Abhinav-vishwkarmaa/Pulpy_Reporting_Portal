          "name": "Dashboard",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/reports/dashboard", "host": ["{{base_url}}"], "path": ["api","admin","reports","dashboard"] }
          }
        },
        {
          "name": "Summary",
