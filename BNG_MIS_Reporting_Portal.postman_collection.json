    {
      "name": "Admin - Assignments",
      "item": [
        {
          "name": "Create Assignment (Multi-Publisher)",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offer_id\": 10,\n  \"publishers\": [\n    {\n      \"publisher_id\": 7,\n      \"payout_override\": 1.50,\n      \"conversion_approval_percentage\": 50,\n      \"capping_budget\": {\n        \"duration\": \"day\",\n        \"amount\": 100\n      },\n      \"capping_conversions\": {\n        \"duration\": \"day\",\n        \"amount\": 50\n      },\n      \"callback_url\": \"https://affiliate.com/postback?click_id={click_id}&payout={payout}\",\n      \"destination_url\": \"https://advertiser.com/landing?click_id={click_id}&rcid={rcid}\",\n      \"notes\": \"Top publisher - custom destination URL override\",\n      \"status\": \"active\"\n    },\n    {\n      \"publisher_id\": 9,\n      \"payout_override\": 2.00,\n      \"conversion_approval_percentage\": 70,\n      \"capping_budget\": {\n        \"duration\": \"month\",\n        \"amount\": 500\n      },\n      \"capping_conversions\": {\n        \"duration\": \"month\",\n        \"amount\": 200\n      },\n      \"notes\": \"Uses default offer.offer_url and publisher.global_postback_url\",\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/assignments", "host": ["{{base_url}}"], "path": ["api","admin","assignments"] },
            "description": "Create assignments for multiple publishers.\n\n**Important:**\n- Tracking URLs are NOT stored - they are generated dynamically at runtime\n- `destination_url` is optional - if not provided, uses `offer.offer_url`\n- `callback_url` is optional - if not provided, uses `publisher.global_postback_url`\n- URLs must contain `{click_id}` or `{rcid}` macro when provided\n- Get tracking URL from `/assignments/:id/tracking-url` endpoint"
          }
        },
        {
          "name": "List Assignments",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/admin/assignments?publisher_id=1&offer_id=10&status=active",
              "host": ["{{base_url}}"],
              "path": ["api","admin","assignments"],
              "query": [
                { "key": "publisher_id", "value": "1", "description": "Filter by publisher ID" },
                { "key": "offer_id", "value": "10", "description": "Filter by offer ID" },
                { "key": "status", "value": "active", "description": "Filter by status: active, inactive, suspended" }
              ]
            }
          }
        },
        {
          "name": "Get Assignment",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/assignments/:id", "host": ["{{base_url}}"], "path": ["api","admin","assignments",":id"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Get assignment details. Returns `destination_url` (null if using offer default) and `callback_url` (null if using publisher default)."
          }
        },
        {
          "name": "Update Assignment",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payout_override\": 18.00,\n  \"conversion_approval_percentage\": 90,\n  \"capping_budget\": {\n    \"duration\": \"week\",\n    \"amount\": 1000.00\n  },\n  \"destination_url\": \"https://custom-landing.com?click_id={click_id}&rcid={rcid}\",\n  \"callback_url\": \"https://custom-postback.com?click_id={click_id}&payout={payout}\",\n  \"status\": \"active\",\n  \"notes\": \"Updated assignment settings\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/assignments/:id", "host": ["{{base_url}}"], "path": ["api","admin","assignments",":id"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Update assignment. All fields are optional. URLs must contain `{click_id}` or `{rcid}` macro if provided."
          }
        },
        {
          "name": "Get Tracking URL",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/assignments/:id/tracking-url", "host": ["{{base_url}}"], "path": ["api","admin","assignments",":id","tracking-url"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Get dynamic tracking URL for assignment. This URL is generated at runtime and should be used by publishers to track clicks. Format: `{BASE_URL}/click?offer_id={offer_id}&pub_id={publisher_id}&tid={TID}`"
          }
        },
        {
          "name": "Delete Assignment",
          "request": {
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "admin@bng.com", "type": "string" }, { "key": "password", "value": "admin123", "type": "string" }] },
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/admin/assignments/:id", "host": ["{{base_url}}"], "path": ["api","admin","assignments",":id"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Soft delete assignment (sets status to 'inactive'). Data is preserved for reporting."
          }
        }
      ]
    },
