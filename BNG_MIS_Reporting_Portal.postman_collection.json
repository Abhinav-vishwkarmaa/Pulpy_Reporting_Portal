          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/offers/live", "host": ["{{base_url}}"], "path": ["api","admin","offers","live"] }
          }
        },
        {
          "name": "List Approved Offers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/offers/approved", "host": ["{{base_url}}"], "path": ["api","admin","offers","approved"] }
          }
        },
        {
          "name": "Get Offer Categories",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/offers/categories", "host": ["{{base_url}}"], "path": ["api","admin","offers","categories"] }
          }
        },
        {
          "name": "Get Offer",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/admin/offers/single/:id", "host": ["{{base_url}}"], "path": ["api","admin","offers","single",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
