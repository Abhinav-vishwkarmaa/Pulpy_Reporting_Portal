    {
      "name": "Tracking (Public)",
      "item": [
        {
          "name": "Track Click",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/click?offer_id=1&pub_id=1&tid=test123&rcid=rcid123&source_id=src1&device_id=dev1&google_id=g1&android_id=a1",
              "host": ["{{base_url}}"],
              "path": ["click"],
              "query": [
                { "key": "offer_id", "value": "1" },
                { "key": "pub_id", "value": "1" },
                { "key": "tid", "value": "test123" },
                { "key": "rcid", "value": "rcid123" },
                { "key": "source_id", "value": "src1" },
                { "key": "device_id", "value": "dev1" },
                { "key": "google_id", "value": "g1" },
                { "key": "android_id", "value": "a1" }
              ]
