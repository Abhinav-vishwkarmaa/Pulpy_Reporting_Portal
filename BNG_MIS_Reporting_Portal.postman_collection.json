            "body": { "mode": "raw", "raw": "{\n  \"status\": \"paused\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/offers/:id/status", "host": ["{{base_url}}"], "path": ["api","admin","offers",":id","status"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
