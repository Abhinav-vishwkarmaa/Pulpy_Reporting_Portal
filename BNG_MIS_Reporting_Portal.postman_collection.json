    {
      "name": "Admin - Offers",
      "item": [
        {
          "name": "Create Offer (all required fields included)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"advertiser_id\": 1,\n  \"name\": \"Spring Promo\",\n  \"offer_currency\": \"USD\",\n  \"country\": \"US\",\n  \"advertiser_model\": \"CPL\",\n  \"advertiser_amount\": 25.00,\n  \"affiliate_model\": \"CPL\",\n  \"affiliate_amount\": 15.00,\n  \"offer_url\": \"https://example.com/offer\",\n  \"description\": \"50% off trial\",\n  \"category\": \"Shopping\",\n  \"status\": \"draft\",\n  \"preview_url\": \"https://example.com/preview\",\n  \"token_type\": \"click_id\",\n  \"macros_json\": { \"click_id\": \"{click_id}\", \"pub_id\": \"{pub_id}\" },\n  \"start_date\": \"2025-01-10\",\n  \"end_date\": \"2025-03-31\",\n  \"start_time\": \"00:00:00\",\n  \"end_time\": \"23:59:59\",\n  \"ip_action\": \"allow\",\n  \"ip_list\": \"1.1.1.1,2.2.2.2\",\n  \"device_targeting_json\": { \"device\": [\"mobile\"] },\n  \"os_targeting_json\": { \"os\": [\"ios\",\"android\"] },\n  \"browser_targeting_json\": { \"browser\": [\"chrome\"] },\n  \"isp_targeting_json\": { \"isp\": [\"verizon\"] },\n  \"carrier_targeting_json\": { \"carrier\": [\"att\"] },\n  \"city_targeting_json\": { \"city\": [\"NYC\"] },\n  \"daily_cap\": 1000,\n  \"monthly_cap\": 20000,\n  \"total_cap\": 50000,\n  \"conversion_cap\": 10000,\n  \"budget_cap\": 100000.00,\n  \"cap_action\": \"pause\",\n  \"fallback_enabled\": true,\n  \"fallback_url\": \"https://example.com/fallback\",\n  \"fallback_offer_id\": 2,\n  \"advertiser_postback_url\": \"https://adv.com/pb\",\n  \"advertiser_postback_method\": \"GET\",\n  \"advertiser_postback_macros_json\": { \"cid\": \"{click_id}\" },\n  \"system_postback_url\": \"https://system.com/pb\",\n  \"system_postback_method\": \"POST\",\n  \"system_postback_macros_json\": { \"status\": \"{status}\" }\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/offers", "host": ["{{base_url}}"], "path": ["api","admin","offers"] }
          }
        },
        {
          "name": "Update Offer (any fields optional)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spring Promo v2\",\n  \"status\": \"live\",\n  \"affiliate_amount\": 18.00,\n  \"macros_json\": { \"click_id\": \"{click_id}\", \"sub_id\": \"{sub_id}\" },\n  \"fallback_enabled\": false\n}"
            },
            "url": { "raw": "{{base_url}}/api/admin/offers/:id", "host": ["{{base_url}}"], "path": ["api","admin","offers",":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
